{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/bandix-ads/schema/ads.schema.json",
  "title": "Bandix advertising configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "updated_at", "refresh_interval", "ads"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "updated_at": { "type": "string", "format": "date-time" },
    "refresh_interval": { "type": "integer", "minimum": 300, "maximum": 86400 },
    "ads": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "enabled", "title", "image", "href", "alt"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
          "enabled": { "type": "boolean" },
          "title": { "type": "string", "minLength": 1, "maxLength": 100 },
          "image": { "type": "string", "minLength": 1, "maxLength": 500 },
          "href": {
            "anyOf": [
              { "const": "" },
              { "type": "string", "format": "uri", "pattern": "^https://" }
            ]
          },
          "alt": { "type": "string", "minLength": 1, "maxLength": 150 }
        }
      }
    }
  }
}
